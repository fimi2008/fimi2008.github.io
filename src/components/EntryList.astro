---
import { entryLabel, entryPath, type Entry } from '../lib/entries';
interface Props {
  entries: Entry[];
  headingLevel?: 'h2' | 'h3';
}
const { entries, headingLevel: Heading = 'h2' } = Astro.props;
---
{entries.length ? (
  <ol class="entry-list">
    {entries.map((entry) => (
      <li class="entry-row">
        <time datetime={entry.data.date}>{entry.data.date.replaceAll('-', '.')}</time>
        <div class="entry-description">
          <div class:list={['entry-category', { 'ai-label': entry.data.kind === 'ai' }]}>{entryLabel(entry)}</div>
          <Heading><a href={entryPath(entry)}>{entry.data.title}</a></Heading>
          <p>{entry.data.description}</p>
        </div>
        <span class="row-arrow" aria-hidden="true">↗</span>
      </li>
    ))}
  </ol>
) : <p class="empty">这里还没有文章。</p>}
